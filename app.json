{
  "expo": {
    "name": "WP B2B",
    "slug": "wp-b2b-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F172A"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.wp.b2bapp"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F172A"
      },
      "package": "com.wp.b2bapp"
    },
    "plugins": [
      "expo-secure-store"
    ],
    "assetBundlePatterns": [
      "**/*"
    ]
  }
}
